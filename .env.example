# Copy to .env and fill in values.
# Works with OpenAI OR any OpenAI-compatible endpoint (OpenRouter, Ollama, etc.)

OPENAI_API_KEY=sk-or-v1-replace-me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Optional embeddings model (same API). Leave blank to use local TF-IDF fallback.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Demo safety
APP_DISCLAIMER=Research/education prototype only. Not a medical device. Clinician decides.
TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
